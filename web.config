<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <!-- 302 Temporary Redirect for temporarily removed collaborate page -->
        <rule name="Redirect contribute" stopProcessing="true">
          <match url="^contribute(/|\.html)?$" />
          <action type="Redirect" url="/" redirectType="Found" />
        </rule>

        <!-- 301 Redirect old APK name to official APK -->
        <rule name="Redirect old apk" stopProcessing="true">
          <match url="^downloads/app-release\.apk$" />
          <action type="Redirect" url="/downloads/daftarche.apk" redirectType="Permanent" />
        </rule>

        <!-- 301 Redirect /index.html to / -->
        <rule name="Redirect index.html" stopProcessing="true">
          <match url="^index\.html$" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_METHOD}" pattern="^POST$" negate="true" />
          </conditions>
          <action type="Redirect" url="/" redirectType="Permanent" />
        </rule>

        <!-- 301 Redirect direct *.html requests to clean URLs (exclude 404.html) -->
        <rule name="Redirect .html extension" stopProcessing="true">
          <match url="^(.*)\.html$" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_METHOD}" pattern="^POST$" negate="true" />
            <add input="{REQUEST_URI}" pattern="404\.html$" negate="true" />
          </conditions>
          <action type="Redirect" url="{R:1}" redirectType="Permanent" />
        </rule>

        <!-- Internally rewrite clean extensionless URLs to .html files -->
        <rule name="Rewrite clean URL to .html" stopProcessing="true">
          <match url="^([^.]+)$" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}.html" matchType="IsFile" />
          </conditions>
          <action type="Rewrite" url="{R:1}.html" />
        </rule>
      </rules>
    </rewrite>
    <security>
      <requestFiltering>
        <fileExtensions>
          <add fileExtension=".bak" allowed="false" />
        </fileExtensions>
      </requestFiltering>
    </security>
    <httpErrors errorMode="Custom" existingResponse="Auto">
      <remove statusCode="404" />
      <error statusCode="404" path="/404.html" responseMode="ExecuteURL" />
    </httpErrors>
  </system.webServer>
</configuration>

