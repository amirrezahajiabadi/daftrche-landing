<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 302 Temporary Redirect for temporarily removed collaborate page
  RewriteRule ^contribute(/|\.html)?$ / [R=302,L]

  # 301 Redirect old APK name to official APK
  RewriteRule ^downloads/app-release\.apk$ /downloads/daftarche.apk [R=301,L]

  # 301 Redirect /index.html to /
  RewriteCond %{THE_REQUEST} \s/index\.html[?\s] [NC]
  RewriteRule ^index\.html$ / [R=301,L]

  # 301 Redirect direct *.html requests to clean URLs (exclude 404.html)
  RewriteCond %{THE_REQUEST} !\s/404\.html[?\s] [NC]
  RewriteCond %{THE_REQUEST} \s/([^.]+)\.html[?\s] [NC]
  RewriteRule ^([^.]+)\.html$ /$1 [R=301,L]

  # Internally rewrite clean extensionless URLs to .html files
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^([^\.]+)$ $1.html [NC,L]
</IfModule>

# Block direct access to backup and temporary files
<FilesMatch "\.(bak|tmp|swp|orig)$">
  Require all denied
</FilesMatch>

# Custom 404 Error Document
ErrorDocument 404 /404.html

